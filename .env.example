# ════════════════════════════════════════════════════════════════════
#  DEVSCOUT – Environment Variables Example
#  Copy this file to .env and fill in real values.
#  Never commit .env to version control.
# ════════════════════════════════════════════════════════════════════

# ── App ───────────────────────────────────────────────────────────
APP_ENV=development          # development | production
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000

# ── Multi-Provider AI Layer (Primary Chat: Groq) ───────────────────
GROQ_API_KEY=your_groq_api_key_here
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TIMEOUT_SECONDS=30.0
    
# ── Multi-Provider AI Layer (Fallback Chat: Cerebras) ──────────────
CEREBRAS_API_KEY=your_cerebras_api_key_here
CEREBRAS_BASE_URL=https://api.cerebras.ai/v1
CEREBRAS_MODEL=llama3.1-8b
CEREBRAS_TIMEOUT_SECONDS=30.0

# ── Multi-Provider AI Layer (Research Provider: Google Gemini) ─────
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_SECONDS=60.0
GEMINI_RPM=4                 # sliding window RPM limiter (default 4)
GEMINI_RPD_LIMIT=18          # daily request budget limit (default 18)

# ── Multi-Provider AI Layer (Optional Local Fallback: Ollama) ──────
OLLAMA_ENABLED=false
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.2
OLLAMA_TIMEOUT_SECONDS=60.0

# ── Pipeline Tuning & Research Caches ─────────────────────────────
GEMINI_QUOTA_FILE=data/quota.json
REQUEST_CACHE_FILE=data/responses.json
RESEARCH_CACHE_FILE=data/research_cache.json
EVIDENCE_CACHE_TTL_SECONDS=86400   # 24 hours
WEB_RESEARCH_MODE=cached           # live | cached
GITHUB_TOKEN=                      # optional: GitHub token to increase API rate limits
MAX_EVIDENCE_RETRY_LOOPS=1         # Stage 4 max retry loops back to Stage 3 (default 1)
CONFIDENCE_THRESHOLD=0.65          # confidence threshold (default 0.65)

# ── Optional / Unused ──────────────────────────────────────────────
# DATABASE_URL=                    # OPTIONAL / UNUSED - PostgreSQL is not used by the current architecture
