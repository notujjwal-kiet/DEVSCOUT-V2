# ════════════════════════════════════════════════════════════════════
#  DEVSCOUT – Environment Variables Example
#  Copy this file to .env and fill in real values.
#  Never commit .env to version control.
# ════════════════════════════════════════════════════════════════════

# ── App ───────────────────────────────────────────────────────────
APP_ENV=development          # development | production
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── LLM Provider & Routing ────────────────────────────────────────
LLM_PROVIDER=gemini          # primary LLM provider (default: gemini)
# LLM_FALLBACK=              # optional fallback provider

# ── Gemini (Google GenAI) ─────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_RPM=4                 # sliding window RPM limiter (default 4)
GEMINI_RPD_LIMIT=18          # daily request budget limit (default 18)

# ── File-Based Persistence & Caches ───────────────────────────────
GEMINI_QUOTA_FILE=data/quota.json
REQUEST_CACHE_FILE=data/responses.json
RESEARCH_CACHE_FILE=data/research_cache.json
EVIDENCE_CACHE_TTL_SECONDS=86400   # 24 hours
WEB_RESEARCH_MODE=cached           # live | cached
GITHUB_TOKEN=                      # optional: GitHub token to increase API rate limits

# ── Pipeline Tuning ───────────────────────────────────────────────
MAX_EVIDENCE_RETRY_LOOPS=1         # Stage 4 max retry loops back to Stage 3 (default 1)
CONFIDENCE_THRESHOLD=0.65          # confidence threshold (default 0.65)

# ── Optional / Unused (DEVSCOUT backend uses in-memory sessions & file-based storage) ──
# DATABASE_URL=                    # OPTIONAL / UNUSED - PostgreSQL is not used by the current architecture
