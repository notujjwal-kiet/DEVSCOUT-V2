# ════════════════════════════════════════════════════════════════════
#  DEVSCOUT – Environment Variables Example
#  Copy this file to .env and fill in real values.
#  Never commit .env to version control.
# ════════════════════════════════════════════════════════════════════

# ── App ───────────────────────────────────────────────────────────
APP_ENV=development          # development | production
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# ── LLM Provider (ollama | gemini) ────────────────────────────────
LLM_PROVIDER=ollama

# ── Ollama (local LLM inference) ──────────────────────────────────
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:4b       # any model pulled in your local Ollama
OLLAMA_TIMEOUT=120           # seconds
OLLAMA_THINK=false           # enable thinking/reasoning traces if supported

# ── Gemini (Google GenAI) ─────────────────────────────────────────
GEMINI_API_KEY=
# Current Gemini model name (e.g. gemini-2.5-flash, gemini-1.5-flash, or gemini-2.5-pro)
GEMINI_MODEL=

# ── PostgreSQL + pgvector ─────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=devscout
POSTGRES_USER=devscout
POSTGRES_PASSWORD=devscout_secret
DATABASE_URL=postgresql+asyncpg://devscout:devscout_secret@localhost:5432/devscout

# ── Evidence cache ────────────────────────────────────────────────
EVIDENCE_CACHE_TTL_SECONDS=86400   # 24 h
WEB_RESEARCH_MODE=cached           # live | cached
# GITHUB_TOKEN=ghp_your_github_personal_access_token_here

# ── Pipeline tuning ───────────────────────────────────────────────
MAX_EVIDENCE_RETRY_LOOPS=2         # Stage 4 max loops back to Stage 3
CONFIDENCE_THRESHOLD=0.65          # below this → retry/repair in Stage 7

# ── AWS (optional – core code never imports these directly) ───────
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# S3_BUCKET=
